#!/bin/sh
# Put the supplied Bandit logo over the left edge of the i3bar.
# i3bar itself only accepts text, so this keeps the real raster logo visible
# while leaving i3bar responsible for workspaces and status information.

set -eu

logo="${BANDIT_LOGO:-$HOME/.local/share/blankon-bandit/logo/bandit-mark.png}"

[ -r "$logo" ] || exit 0
command -v feh >/dev/null 2>&1 || exit 0
command -v i3-msg >/dev/null 2>&1 || exit 0

i3-msg '[title="Bandit Logo"] kill' >/dev/null 2>&1 || true
feh --no-fehbg --borderless --no-menus --title "Bandit Logo" \
    --geometry 26x26+18+13 --scale-down "$logo" >/dev/null 2>&1 &

sleep 0.2
i3-msg '[title="Bandit Logo"] floating enable, sticky enable, border pixel 0, move position 18 px 13 px' >/dev/null 2>&1 || true
